[Unit]
Description=Fire the Wheel Bot tick every 5 minutes

[Timer]
# D7: wall-clock anchored. The old OnUnitActiveSec chain measured 5.18-6.85
# min of phase slip (every fixed window was entered by luck) and left NO next
# trigger after `systemctl stop` -- hit live during the migration deploy.
# Persistent= only applies to OnCalendar timers, so before this line it was
# decoration. The VPS clock is UTC; the tick does all ET gating internally.
OnCalendar=*:0/5
OnBootSec=2min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
